rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 관리자 권한 확인 헬퍼 함수
    // 로그인된 사용자의 UID가 '/databases/{database}/documents/admins/{uid}'에 존재하는지 검사합니다.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 2. 관리자 명부 컬렉션 규칙
    // 누구나 로그인하면 읽을 수는 있으나, 쓰기/수정은 오직 파이어베이스 콘솔에서 수동으로만 가능하도록 제한합니다.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 3~6. 옛 퀴즈 앱 · 카날루프가 쓰던 컬렉션 (보관용, 2026-11-21 쓰기 닫음)
    //    suggestions, speedrun_rankings, study_rankings, users(+ 하위 컬렉션), visits
    //    퀴즈 앱은 공용 프로젝트 quizquiz-quiz 의 앱별 컬렉션({앱}_speedrun_rankings 등)으로 옮겼고,
    //    이 사이트(iseohyun.com)는 이 컬렉션들을 쓰지 않는다. 예전 규칙은 비로그인 쓰기(create: if true,
    //    GUEST_ 문서 ID)를 열어 두어 누구나 무제한으로 문서를 만들 수 있었다.
    //    관리자만 읽고(내보내기 · 확인) 지울(정리) 수 있게 남긴다. 다시 쓰는 앱이 생기면 그 앱의 필드에 맞춰
    //    필드 고정(keys().hasOnly) · 길이 제한 · 서버 시각 · 도배 방지를 갖춘 규칙을 새로 쓴다.
    match /suggestions/{docId} {
      allow read, delete: if isAdmin();
    }

    match /speedrun_rankings/{docId} {
      allow read, delete: if isAdmin();
    }

    match /study_rankings/{docId} {
      allow read, delete: if isAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, delete: if isAdmin();
    }

    match /visits/{docId} {
      allow read, delete: if isAdmin();
    }

    // 7. 문의 대화 (받는 사람 기기에 푸시). 로그인한 사람만 적는다.
    //    kind: 'mail'(메일 문의를 함께 적음) 또는 'direct'(문의 창의 대화에서 보냄)
    //    thread: 대화 묶음 = 관리자가 아닌 쪽의 uid. 관리자가 아니면 받는 사람(to)은 관리자만 되고,
    //    같은 사람은 10초에 한 번만 적을 수 있다: contact_rate/{uid}.lastAt 을 같은 일괄 쓰기에서 지금 시각으로 고쳐야 한다.
    //    관리자는 제한이 없다. 받은 사람은 read 만 true 로 바꿀 수 있다.
    //    diag(선택): 보낸 사람 화면의 최근 오류와 환경. 관리자 대화 화면의 「진단」에만 보인다.
    function contactRatePath() {
      return /databases/$(database)/documents/contact_rate/$(request.auth.uid);
    }

    match /contact_rate/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt'])
        && request.resource.data.lastAt == request.time
        && (resource == null || request.time > resource.data.lastAt + duration.value(10, 's'));
    }

    match /contact_messages/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'fromName', 'to', 'thread', 'threadName', 'kind', 'message', 'page', 'url', 'diag', 'read', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 80
        && request.resource.data.threadName is string
        && request.resource.data.threadName.size() <= 80
        && request.resource.data.to is string
        && (isAdmin() || exists(/databases/$(database)/documents/admins/$(request.resource.data.to)))
        && request.resource.data.thread == (isAdmin() ? request.resource.data.to : request.auth.uid)
        && request.resource.data.kind in ['mail', 'direct']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 5000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 1000
        && (!('diag' in request.resource.data) || (request.resource.data.diag is string && request.resource.data.diag.size() <= 4000))
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (isAdmin() || getAfter(contactRatePath()).data.lastAt == request.time);
      allow read: if isAdmin() || (request.auth != null && resource.data.thread == request.auth.uid);
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if isAdmin();
    }

    // 8. 기기의 푸시 토큰 (문서 ID = 토큰의 SHA-256). 로그인한 사람이 자기 기기의 것만 적고 지운다.
    //    관리자는 목록을 읽어 「알림 꺼짐」 표시를 만든다. Cloud Functions 는 규칙을 거치지 않는다.
    match /push_tokens/{tokenId} {
      allow get: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['token', 'uid', 'device', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 200
        && request.resource.data.updatedAt == request.time
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 9. 접속 표시. 로그인해 있는 동안 자기 이름과 마지막으로 본 때를 적고, 관리자만 읽는다(받는 사람 목록).
    match /presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.lastSeen == request.time;
    }
  }
}
