rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 관리자 권한 확인 헬퍼 함수
    // 로그인된 사용자의 UID가 '/databases/{database}/documents/admins/{uid}'에 존재하는지 검사합니다.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 2. 관리자 명부 컬렉션 규칙
    // 누구나 로그인하면 읽을 수는 있으나, 쓰기/수정은 오직 파이어베이스 콘솔에서 수동으로만 가능하도록 제한합니다.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 본인 문서 판별 헬퍼: 로그인 사용자는 UID 일치, 비로그인 게스트는 GUEST_ 접두 문서 ID
    function isOwner(docId) {
      return (request.auth != null && request.auth.uid == docId)
          || (request.auth == null && docId.matches('^GUEST_.*'));
    }

    // 3. 건의사항 컬렉션 규칙 (메인 사이트 피드백 및 카날루프 공유)
    match /suggestions/{userId} {
      // 본인 문서는 단건 조회(get)만 허용합니다. 목록 조회(list)를 막아 타인의 게스트 문서 ID 열람을 차단합니다.
      allow get: if isOwner(userId);

      // 본인은 작성/수정할 수 있으나, 관리자 답변(reply) 필드는 변경할 수 없고 건의 본문 길이를 제한합니다.
      allow create, update: if isOwner(userId)
        && request.resource.data.get('reply', '') == (resource == null ? '' : resource.data.get('reply', ''))
        && request.resource.data.get('suggestion', '') is string
        && request.resource.data.get('suggestion', '').size() <= 5000;

      // 관리자는 모든 사용자의 건의사항을 읽고 쓸(답변 저장) 수 있습니다.
      allow read, write: if isAdmin();
    }

    // 4. 스피드런 및 학습모드 랭킹 규칙
    // 누구나 조회 및 신규 기록 등록(게스트 포함)이 가능하나, 기존 기록의 수정/삭제는 관리자만 가능합니다.
    match /speedrun_rankings/{rankingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /study_rankings/{rankingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 5. 사용자 환경설정 문서 규칙
    match /users/{uid} {
      // 목록 조회(list)는 허용하지 않고 본인 문서의 단건 조회/쓰기만 허용합니다.
      allow get, write: if isOwner(uid);

      // 사용자 진행 상태 서브컬렉션 (하위 경로 모두 허용)
      match /progress/{document=**} {
        allow read, write: if isOwner(uid);
      }

      // 사용자 복습통계 서브컬렉션 (하위 경로 모두 허용)
      match /study_stats/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // 6. 방문 기록 컬렉션 규칙
    match /visits/{userId} {
      allow get, write: if isOwner(userId);
    }
  }
}
