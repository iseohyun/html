---
/**
 * 사이트맵 트리의 한 단계 (기존 navigation.js 의 renderHierarchy 를 빌드할 때 그린다).
 * 같은 단계 안에서는 묶음이 위쪽, 낱개 문서가 아래쪽이다. 지금 문서까지의 가지는 펼쳐 둔다.
 */
import { Hierarchy, hrefFor } from '../lib/site.mjs';
import Icon from './Icon.astro';

interface Props {
  items: any[];
  parentDirs: string;
  current: string;
}

const { items, parentDirs, current } = Astro.props;
const isFolderItem = (item: any) => Object.prototype.hasOwnProperty.call(item, '목록');
const visible = Hierarchy.visibleItems(items);
const ordered = visible.filter(isFolderItem).concat(visible.filter((item: any) => !isFolderItem(item)));

// 이 항목(또는 그 아래)에 지금 문서가 있는지
function containsCurrent(item: any, dirs: string): boolean {
  if (Hierarchy.isPageItem(item) && Hierarchy.getItemUrl(dirs, item) === current) return true;
  if (!item.목록) return false;
  const childDirs = Hierarchy.resolveDirs(dirs, item.디렉토리);
  return item.목록.some((child: any) => containsCurrent(child, childDirs));
}

const nodes = ordered.map((item: any) => {
  const isFolder = isFolderItem(item);
  const isPage = Hierarchy.isPageItem(item);
  const url = isPage ? Hierarchy.getItemUrl(parentDirs, item) : '';
  const isCurrent = isPage && url === current;
  const onPath = isFolder && containsCurrent(item, parentDirs);
  const classes = [
    isFolder && 'folder',
    isFolder && !onPath && 'collapsed',
    isFolder && onPath && !isCurrent && 'this-path',
    isCurrent && 'this-doc',
    item.형식 && 'is-app',
  ].filter(Boolean).join(' ');
  return {
    item,
    isFolder,
    isPage,
    href: isPage ? hrefFor(url) : '',
    classes,
    count: isFolder ? Hierarchy.countPages(item) : 0,
    childDirs: isFolder ? Hierarchy.resolveDirs(parentDirs, item.디렉토리) : '',
    showChildren: isFolder && item.display !== 'hidden' && item.목록.length > 0,
  };
});
---
{nodes.map((node) => (
  <li class={node.classes || undefined}>
    {node.isFolder ? (
      <div class="tree-row">
        <button type="button" class="tree-toggle" aria-label={`${node.item.주제} 접기/펴기`}><Icon name="chevron-right" /></button>
        {node.isPage
          ? <a class="tree-label" href={node.href} title={node.item.형식}>{node.item.주제}</a>
          : <span class="tree-label">{node.item.주제}</span>}
        <span class="tree-count">({node.count})</span>
      </div>
    ) : (
      <a class="tree-label" href={node.href} title={node.item.형식}>{node.item.주제}</a>
    )}
    {node.showChildren && (
      <ul><Astro.self items={node.item.목록} parentDirs={node.childDirs} current={current} /></ul>
    )}
  </li>
))}
